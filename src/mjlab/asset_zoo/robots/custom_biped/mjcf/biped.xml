        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.776471 0.756863 0.737255 1" mesh="right_leg_link"/>
        <geom type="mesh" rgba="0.776471 0.756863 0.737255 1" mesh="right_leg_link"/>
        <body name="right_knee_link" pos="0.0299965 0.228032 -0.053">
