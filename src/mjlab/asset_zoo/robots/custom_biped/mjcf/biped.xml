            <joint name="right_ankle_joint" pos="0 0 0" axis="0 0 -1" limited="true" range="-0.785 0.785" class="leg_joint_param"/>
            <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.776471 0.756863 0.737255 1" mesh="right_ankle_link"/>
            <geom
              name="right_foot_collision"
              type="mesh"
              friction="0.6 0.2 0.2"
              rgba="0.776471 0.756863 0.737255 1"
